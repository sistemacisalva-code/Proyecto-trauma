# ============================================================
# Plantilla de variables de entorno. Copiar a ".env" y completar.
# NUNCA subir el ".env" real al repositorio (esta plantilla solo lleva marcadores).
# Nota: main.py arma la URL de conexion sin codificarla; evitar los caracteres
# @ : / en las contrasenas.
# ============================================================

# --- Administrador de PostgreSQL (solo para el bootstrap de main.py) ---
# Se conecta a la base "postgres" para crear roles y la base de datos.
# Necesita CREATEDB y CREATEROLE. En desarrollo suele ser el superusuario "postgres"
# del instalador; en produccion, un rol dedicado sin SUPERUSER.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# --- Entorno activo ---
# Valores validos: development | production. Si se deja la linea vacia, main.py falla
# (una cadena vacia no activa el valor por defecto); borrarla equivale a development.
APP_ENV=development

# --- Base de datos de pruebas (pytest) ---
# Las pruebas de integracion la crean y la BORRAN en cada corrida.
# Debe terminar en "_test" y ser distinta de DB_NAME_DEV y DB_NAME_PROD.
DB_NAME_TEST=trauma_cdw_test

# --- Desarrollo (APP_ENV=development) ---
DB_HOST=
DB_PORT=
# Nombre de la base de datos de desarrollo (se crea si no existe).
DB_NAME_DEV=
# Rol de la aplicacion: duenio de la base; crea el DDL y carga los datos (ETL).
DB_USER_DEV=
DB_PASSWORD=
# Rol lector de solo lectura para Power BI (ver database/schema/04_permissions.sql).
DB_READER_USER=
DB_READER_PASSWORD=

# --- Produccion (APP_ENV=production) ---
# El nombre de la base de datos va en DB_NAME_PROD (asi lo lee config/database.yaml).
DB_HOST_PROD=
DB_PORT_PROD=
DB_NAME_PROD=
DB_USER_PROD=
DB_PASSWORD_PROD=
DB_READER_USER_PROD=
DB_READER_PASSWORD_PROD=

# --- REDCap (extracción periódica) ---
# Token de la API del proyecto REDCap. DEBE configurarse en REDCap como
# token de SOLO LECTURA (permiso "API Export" unicamente, sin "API Import/Update"
# ni "API-Delete"), para que esta extraccion nunca pueda modificar la fuente.
# NUNCA pegar aqui el token real; esta plantilla solo lleva marcadores.
REDCAP_API_URL=
REDCAP_API_TOKEN=

# --- Seudonimizacion del documento de identidad (transformacion de REDCap) ---
# Clave secreta del HMAC-SHA256 con que se seudonimiza numero_de_identificacion.
# Generar UNA vez con:  python -c "import secrets; print(secrets.token_hex(32))"
# Debe ser estable: si cambia, los pacientes ya cargados no se pueden vincular con las cargas
# nuevas; si se pierde, no se puede reproducir. Respaldarla fuera del repositorio.
# NUNCA pegar aqui la clave real; esta plantilla solo lleva marcadores.
PSEUDONYMIZATION_KEY=

